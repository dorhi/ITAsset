[Unit]
Description=SAE-A IT Asset Management Spring Boot Application
After=network.target mysql.service

[Service]
User=ubuntu
Group=ubuntu
# 권한 문제가 발생할 경우를 대비하여 작업 디렉토리 지정
WorkingDirectory=/opt/itasset/backend

# 배포된 JAR 파일 실행 경로 (경로는 실제 서버 환경에 맞게 수정)
ExecStart=/usr/bin/java -jar /opt/itasset/backend/target/backend-0.0.1-SNAPSHOT.jar

# 환경 변수 파일 로드 (.env 파일을 활용한 설정 주입)
EnvironmentFile=-/opt/itasset/backend/.env

SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
